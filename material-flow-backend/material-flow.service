[Unit]
Description=Material Flow API
After=network-online.target
Wants=network-online.target

[Service]
User=material-flow
Group=material-flow
WorkingDirectory=/srv/material-flow
EnvironmentFile=/etc/material-flow/material-flow.env
ExecStart=/srv/material-flow/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/material-flow/data /srv/material-flow/uploads

[Install]
WantedBy=multi-user.target
