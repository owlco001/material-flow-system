material {
    name : GhostMaterial,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : true,
    culling : none
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // 固定淡蓝色半透明，不用自定义参数
        material.baseColor = vec4(0.55, 0.65, 0.85, 0.18);
    }
}
