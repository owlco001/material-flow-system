material {
    name : GhostMaterial,
    shadingModel : lit,
    blending : transparent,
    depthWrite : true,
    culling : none
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(0.55, 0.65, 0.85, 0.18);
        material.roughness = 0.8;
        material.metallic = 0.0;
    }
}
