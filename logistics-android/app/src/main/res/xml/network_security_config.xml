<?xml version="1.0" encoding="utf-8"?>
<!--
  Release 网络安全基线：仅允许系统信任链上的 HTTPS。
  Debug 变体使用 app/src/debug/res/xml/network_security_config.xml，
  仅为受控内网真机验收临时允许 HTTP；变更后必须重新打包 APK。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
